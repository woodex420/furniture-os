# STAGING ONLY. Copy to the private furniture-app/.env; never put in public_html.
# Enter host-specific database values privately. Never commit or share this file.
APP_NAME="WOODEX Furniture Staging"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.blackibex.net
LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FILESYSTEM_DISK=local
FURNITURE_STOREFRONT_BUNDLE_ENABLED=true
FURNITURE_HOME_EDITOR_ENABLED=true
FURNITURE_SERVICE_COPY_ENABLED=true
FURNITURE_CITY_PAGES_ENABLED=true
FURNITURE_BLOG_POSTS_ENABLED=true
FURNITURE_CONTACT_CREATION_ENABLED=true
FURNITURE_LEAD_CREATION_ENABLED=true
FURNITURE_LEAD_EDITING_ENABLED=true
FURNITURE_MEDIA_LIBRARY_ENABLED=true
FURNITURE_ADMIN_PREVIEW_LANDING=false
FURNITURE_SYNTHETIC_PREVIEW_LOGIN_LIMIT=false
FURNITURE_STOREFRONT_CANVAS_URL=https://staging.blackibex.net
