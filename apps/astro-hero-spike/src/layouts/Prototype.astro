---
import '../../../reimagined-storefront/src/index.css';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Astro prototype</title>
    <meta name="description" content="Synthetic component experiment, not the Furniture storefront." />
  </head>
  <body>
    <div class="preview-notice" role="note"><strong>ASTRO PROTOTYPE</strong> · Synthetic component experiment. Not a live catalogue or production release.</div>
    <nav aria-label="Prototype pages" class="container mx-auto flex flex-wrap gap-4 px-4 py-4 text-sm font-semibold">
      <a href="/" class="text-accent">Hero</a>
      <a href="/experiments/product/" class="text-accent">Product gallery</a>
      <a href="/experiments/article/" class="text-accent">Article</a>
    </nav>
    <slot />
  </body>
</html>
